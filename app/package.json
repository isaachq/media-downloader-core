{
  "name": "media-download-core-app",
  "productName": "Media Download Core",
  "version": "0.2.0-beta.14.5",
  "description": "Desktop app for media-downloader-core: heavy batch downloads with integrity validation.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "isaachq <isaac.hernandez.qz@gmail.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "icon": "electron scripts/render-icon.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never && electron-builder --win --arm64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "antd": "6.6.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "media-downloader-core": "file:..",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "build": {
    "appId": "io.github.isaachq.mediadownloadcore",
    "productName": "Media Download Core",
    "copyright": "Copyright (c) 2026 isaachq",
    "artifactName": "Media-Download-Core-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Media Download Core ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo",
      "executableName": "media-download-core",
      "synopsis": "Heavy-duty batch downloads, verified file by file",
      "maintainer": "isaachq <isaac.hernandez.qz@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "Media Download Core",
          "Comment": "Heavy-duty batch downloads, verified file by file",
          "Keywords": "download;playlist;video;audio;"
        }
      },
      "icon": "build/icons"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://github.com/isaachq/media-downloader-core"
}
