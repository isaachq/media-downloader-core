{
  "name": "media-downloader-core",
  "version": "1.11.0",
  "description": "Download engine for heavy workloads (many videos, huge playlists): yt-dlp + ffmpeg on a CPUs/2 worker pool, O(1) hot paths, codec-guaranteed formats and full integrity validation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mdc": "dist/cli.js",
    "media-download-core": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsup --config tsup.config.ts && vite build",
    "build:watch": "tsup --config tsup.config.ts --watch",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "stress": "node --expose-gc --import tsx scripts/stress.ts",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run check && npm run build",
    "mdc": "tsx src/cli/bin.ts",
    "bench": "node --expose-gc --import tsx scripts/batch-bench.ts",
    "bench:archive": "node --expose-gc --import tsx scripts/archive-bench.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "author": "isaachq <isaac.hernandez.qz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaachq/media-downloader-core.git"
  },
  "homepage": "https://github.com/isaachq/media-downloader-core#readme",
  "bugs": "https://github.com/isaachq/media-downloader-core/issues",
  "keywords": [
    "media-backup",
    "playlist-archiver",
    "video-archiver",
    "integrity-check",
    "ffmpeg",
    "electron",
    "typescript"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
